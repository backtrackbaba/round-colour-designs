---
import {getCollection} from 'astro:content'; import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import Button from '../components/Button.astro'; import FAQSection from '../components/FAQSection.astro'; import {site} from '../config/site'; import {faqSchema,breadcrumbSchema} from '../config/schema'; const faq=(await getCollection('faqs')).filter(x=>x.data.pages.includes('contact')); const crumbs=[{label:'Home',href:'/'},{label:'Contact',href:'/contact/'}];
---
<BaseLayout title="Contact Round Colour Designs" description="Book a free interior design consultation with Round Colour Designs in Mulund West, Mumbai." jsonLd={[breadcrumbSchema(crumbs),faqSchema(faq.map(x=>x.data))]}><PageHero eyebrow="Free initial consultation" title="Tell us what you are planning." intro="Share the property type, location and what you want to improve. WhatsApp is the quickest way to begin." image="/assets/founders-couple.jpg"/><section class="section"><div class="container contact-grid"><div><p class="eyebrow">Contact the studio</p><h2 class="type-section-title">Start with a simple conversation.</h2><p class="type-body-lg">No standard packages or starting prices are published because every project has a different scope. We first understand the requirement and then prepare a relevant proposal.</p><div class="contact-actions"><Button href={site.whatsapp} variant="whatsapp" icon="whatsapp" external>Chat on WhatsApp</Button><Button href={site.phoneHref} variant="dark">Call {site.phone}</Button></div><address><strong>Round Colour Designs</strong><br/>{site.address}<br/>Consultations by prior appointment.</address></div><form class="enquiry-form" id="enquiry-form"><label>Your name<input name="name" required autocomplete="name"/></label><label>Phone number<input name="phone" required inputmode="tel" autocomplete="tel"/></label><label>Project type<select name="type"><option>Residential interior</option><option>Commercial interior</option><option>Restaurant / hospitality</option><option>Bungalow / villa</option><option>Farmhouse</option><option>Kitchen / renovation</option></select></label><label>Project location<input name="location" required/></label><label>Tell us briefly about the project<textarea name="message" rows="5"></textarea></label><button type="submit" class="btn btn-whatsapp">Continue on WhatsApp</button><p class="form-note">This form prepares a WhatsApp message. It does not store your details on the website.</p></form></div></section><FAQSection items={faq.map(x=>x.data)} title="Before you contact us"/><script>document.querySelector('#enquiry-form')?.addEventListener('submit',e=>{e.preventDefault();const d=new FormData(e.currentTarget);const text=`Hello Round Colour Designs, I would like to discuss a project.

Name: ${d.get('name')}
Phone: ${d.get('phone')}
Project type: ${d.get('type')}
Location: ${d.get('location')}
Details: ${d.get('message')||'-'}`;window.open(`https://wa.me/919833992725?text=${encodeURIComponent(text)}`,'_blank','noopener')});</script></BaseLayout>
