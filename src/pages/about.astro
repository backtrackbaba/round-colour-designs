---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import FounderCard from '../components/FounderCard.astro'; import Button from '../components/Button.astro'; import {site} from '../config/site'; import {breadcrumbSchema} from '../config/schema'; const crumbs=[{label:'Home',href:'/'},{label:'About',href:'/about/'}];
---
<BaseLayout title="About the Studio and Founders" description="Meet Akshay and Pratibha Vanare, the couple behind Round Colour Designs in Mulund, Mumbai." jsonLd={[breadcrumbSchema(crumbs),{'@context':'https://schema.org','@graph':[{'@type':'Person',name:'Akshay Vanare',jobTitle:'Co-Founder & Head of Design Execution',worksFor:{'@type':'Organization',name:site.name}},{'@type':'Person',name:'Pratibha Vanare',jobTitle:'Co-Founder & Head of Kitchen Design and Client Experience',worksFor:{'@type':'Organization',name:site.name}}]}]}><PageHero eyebrow="About Round Colour Designs" title="A design partnership built on a shared love for thoughtful spaces." intro="Founded in 2022, Round Colour Designs is a Mulund-based interior studio working across homes, workplaces, restaurants and larger residences." image="/assets/founders-couple.jpg"/><section class="section"><div class="container prose-grid"><div><p class="eyebrow">The story</p><h2 class="type-section-title">From colleagues to life partners and co-founders.</h2></div><div><p class="type-body-lg">Akshay and Pratibha first met while working in the interior design industry. What began as a shared passion for thoughtful spaces became a partnership beyond work.</p><p>As they collaborated, they found that their skills naturally complemented one another: Pratibha brought an understanding of clients, kitchens and everyday function, while Akshay brought project design, technical detailing and execution leadership.</p><p>They founded Round Colour Designs to bring those strengths together under one accountable studio. Each project is treated personally, with the same attention they would give to designing a space for themselves.</p></div></div></section><section class="section theme-warm"><div class="container founder-grid"><FounderCard name="Akshay Vanare" title="Co-Founder & Head of Design Execution" experience="Diploma in Interior Designing with 10+ years of experience in planning, technical detailing, site coordination and execution." image="/assets/akshay-placeholder.jpg"/><FounderCard name="Pratibha Vanare" title="Co-Founder & Head of Kitchen Design & Client Experience" experience="Diploma in Interior Designing with 5+ years of experience, specialising in kitchen solutions, practical planning and client collaboration." image="/assets/pratibha-placeholder.jpg"/></div></section><section class="section"><div class="container value-grid">{[['Personal involvement','The founders remain close to design decisions, communication and execution.'],['Practical creativity','Aesthetic ideas are tested against circulation, storage, maintenance and everyday use.'],['One connected process','Design development and execution are coordinated rather than treated as separate worlds.'],['Tailored scope','Services and investment are defined after understanding the actual project.']].map(x=><article><h3 class="type-card-title">{x[0]}</h3><p>{x[1]}</p></article>)}</div></section><section class="section cta-section"><div class="container"><h2 class="type-section-title">Meet the studio behind your future space.</h2><div class="actions"><Button href={site.whatsapp} variant="whatsapp" icon="whatsapp" external>Book a free consultation</Button><Button href="/projects/">Explore projects</Button></div></div></section></BaseLayout>
