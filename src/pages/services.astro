---
import {getCollection} from 'astro:content'; import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import Button from '../components/Button.astro'; import FAQSection from '../components/FAQSection.astro'; import {site} from '../config/site'; import {faqSchema,breadcrumbSchema} from '../config/schema'; const services=(await getCollection('services')).sort((a,b)=>a.data.order-b.data.order); const faq=(await getCollection('faqs')).filter(x=>x.data.pages.includes('services')).sort((a,b)=>a.data.order-b.data.order); const crumbs=[{label:'Home',href:'/'},{label:'Services',href:'/services/'}];
---
<BaseLayout title="Interior Design Services in Mulund and Mumbai" description="Residential, commercial, restaurant, kitchen, renovation and turnkey interior design services from Round Colour Designs." jsonLd={[breadcrumbSchema(crumbs),faqSchema(faq.map(x=>x.data)),...services.map(x=>({'@context':'https://schema.org','@type':'Service',name:x.data.title,description:x.data.summary,provider:{'@type':'InteriorDesignService',name:site.name}}))]}><PageHero eyebrow="Interior design services" title="From first layout to final handover." intro="Choose focused design support or a complete turnkey engagement. The scope is built around the property and the result you need." image="/assets/project-residential.jpg"><div class="actions"><Button href={site.whatsapp} variant="primary" icon="whatsapp" external>Discuss your project</Button></div></PageHero><nav class="service-jump container" aria-label="Service sections">{services.map(x=><a href={`#${x.id}`}>{x.data.shortTitle}</a>)}</nav>{services.map((x,i)=><section class:list={['section','service-detail',i%2&&'theme-warm']} id={x.id}><div class="container service-detail-grid"><img src={x.data.image} alt="" loading="lazy"/><div><p class="eyebrow">0{i+1} · {x.data.shortTitle}</p><h2 class="type-section-title">{x.data.title}</h2><p class="type-body-lg">{x.data.summary}</p><ul class="check-list">{x.data.features.map(y=><li>{y}</li>)}</ul><p>Architectural and structural services, where required, are coordinated with suitably qualified professionals.</p><Button href={site.whatsapp} variant="secondary" icon="whatsapp" external>Ask about this service</Button></div></div></section>)}<FAQSection items={faq.map(x=>x.data)} title="Questions about our services"/></BaseLayout>
