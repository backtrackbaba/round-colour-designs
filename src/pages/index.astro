---
import {getCollection} from 'astro:content'; import BaseLayout from '../layouts/BaseLayout.astro'; import Button from '../components/Button.astro'; import SectionHeading from '../components/SectionHeading.astro'; import ProjectCard from '../components/ProjectCard.astro'; import ServiceCard from '../components/ServiceCard.astro'; import Testimonial from '../components/Testimonial.astro'; import FAQSection from '../components/FAQSection.astro'; import {site} from '../config/site'; import {localBusinessSchema,faqSchema} from '../config/schema';
const projects=(await getCollection('projects')).filter(x=>x.data.featured); const services=(await getCollection('services')).sort((a,b)=>a.data.order-b.data.order); const testimonials=await getCollection('testimonials'); const faq=(await getCollection('faqs')).filter(x=>x.data.pages.includes('home')).sort((a,b)=>a.data.order-b.data.order);
---
<BaseLayout title="Interior Designers in Mulund, Mumbai" description="Founder-led residential, commercial, restaurant, bungalow and farmhouse interior design and turnkey execution across Mulund, MMR and Maharashtra." jsonLd={[localBusinessSchema,faqSchema(faq.map(x=>x.data))]}><section class="hero"><div class="hero-copy"><p class="eyebrow">Interior design studio · Mulund, Mumbai</p><h1 class="type-hero">Spaces shaped around the way you live.</h1><p class="type-body-lg">Round Colour Designs plans and executes personalised homes, workplaces and hospitality spaces across Mumbai, MMR and Maharashtra.</p><div class="actions"><Button href="/contact/" variant="primary">Book a Free Consultation</Button><Button href="/projects/">Explore Projects</Button></div><dl class="hero-stats"><div><dt>10+</dt><dd>Years of industry experience</dd></div><div><dt>20+</dt><dd>Completed projects</dd></div><div><dt>2022</dt><dd>Studio established</dd></div></dl></div><div class="hero-visual"><div class="hero-note"><span class="eyebrow">Founder-led studio</span><b>Design vision. Site discipline. One accountable team.</b></div></div></section><section class="section"><div class="container grid-2"><div><p class="eyebrow">Direct answer</p><h2 class="type-section-title">What does Round Colour Designs do?</h2></div><div><p class="type-body-lg">We provide interior consultation, space planning, 2D drawings, 3D visualisation, modular kitchens, custom furniture, renovation, project supervision and turnkey execution.</p><p>Every proposal is tailored after understanding the property, requirements, timeline and expected investment.</p><Button href="/services/">View all services</Button></div></div></section><section class="section theme-warm"><div class="container"><SectionHeading eyebrow="Selected expertise" title="One studio for every stage of your space." intro="From early planning to final handover, services can be combined around the needs of the project."/><div class="service-grid">{services.map(x=><ServiceCard slug={x.id} {...x.data}/>)}</div></div></section><section class="section"><div class="container"><SectionHeading eyebrow="Selected work" title="Spaces with a story." intro="Representative case studies showing how the final project portfolio will be structured."/><div class="project-grid">{projects.map(x=><ProjectCard slug={x.id} {...x.data} image={x.data.cover.src}/>)}</div></div></section><section class="section theme-dark" id="process"><div class="container"><SectionHeading eyebrow="How we work" title="A clear path from first conversation to handover."/><ol class="process-grid">{[['Understand','We discuss lifestyle, business needs, preferences, scope and expected investment.'],['Visit & measure','The property is studied, measured and documented before design decisions begin.'],['Plan & visualise','Layouts, concepts, drawings, materials and visualisations make the proposal clear.'],['Refine','Feedback is incorporated and key design and execution decisions are finalised.'],['Execute','Materials, specialists, custom work and on-site activity are coordinated.'],['Deliver','Quality checks and final detailing are completed before handover.']].map((x,i)=><li><span>0{i+1}</span><h3 class="type-card-title">{x[0]}</h3><p>{x[1]}</p></li>)}</ol></div></section><section class="section"><div class="container grid-2"><div><img class="founder-wide" src="/assets/founders-couple.jpg" alt="Stock couple photograph used as a temporary pose reference for Akshay and Pratibha Vanare"/></div><div><p class="eyebrow">Akshay & Pratibha Vanare</p><h2 class="type-section-title">Two perspectives. One shared vision.</h2><p class="type-body-lg">They met while working in interior design, discovered how naturally their strengths complemented one another, and founded Round Colour Designs in 2022.</p><p>Akshay leads project design and execution. Pratibha specialises in kitchen solutions and client experience. Together, they approach every home with the care they would bring to creating their own.</p><Button href="/about/">Meet the founders</Button></div></div></section><section class="section theme-warm"><div class="container"><SectionHeading eyebrow="Client perspective" title="Designed around real people."/><div class="testimonial-grid">{testimonials.map(x=><Testimonial {...x.data}/>)}</div></div></section><FAQSection items={faq.map(x=>x.data)}/><section class="section cta-section"><div class="container"><p class="eyebrow">Start a conversation</p><h2 class="type-section-title">Your space deserves more than a standard solution.</h2><p class="type-body-lg">Tell us what you are planning. The initial consultation is free and pricing is prepared only after understanding the project.</p><div class="actions"><Button href={site.whatsapp} variant="whatsapp" icon="whatsapp" external>Chat on WhatsApp</Button><Button href={site.phoneHref} variant="dark">Call {site.phone}</Button></div></div></section></BaseLayout>
