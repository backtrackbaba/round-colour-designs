---
import BaseLayout from '../layouts/BaseLayout.astro';
const projects=[['The Aarna Residence','Mulund West · Residence','/assets/logo-original.jpeg'],['Ember & Grain','Powai · Restaurant','/assets/founders-couple.jpg'],['The Verdant House','Karjat · Farmhouse','/assets/pratibha-placeholder.jpg']];
---
<BaseLayout title="Interior Designers in Mulund, Mumbai | Round Colour Designs" description="Residential, commercial and hospitality interior design and turnkey execution across Mulund, MMR and Maharashtra.">
<section class="hero"><div class="hero-copy"><span class="eyebrow">Interior design studio · Mulund, Mumbai</span><h1 class="type-hero">Spaces shaped around the way you live.</h1><p class="type-body-lg">Thoughtful residential, commercial and hospitality interiors—planned with clarity and executed with care.</p><div class="actions"><a class="btn btn-primary" href="/contact">Book a Free Consultation</a><a class="btn" href="/projects">Explore Projects</a></div></div><div class="hero-visual"><div class="hero-note"><span class="eyebrow">Founder-led studio</span><b>Design vision. Site discipline. One accountable team.</b></div></div></section>
<section class="section"><div class="container grid-2"><div><span class="eyebrow">The studio</span><h2 class="type-section-title">Design begins by understanding you.</h2><p class="type-body-lg">Founded by Akshay and Pratibha Vanare, the studio brings together client understanding, spatial planning and execution expertise.</p></div><blockquote class="card type-card-title">“We craft every home with the same care we would bring to creating our own.”</blockquote></div></section>
<section class="section" style="background:var(--surface-alt)"><div class="container"><span class="eyebrow">Selected work</span><h2 class="type-section-title">Spaces with a story.</h2><div class="project-grid">{projects.map(([title,meta,img])=><a class="project" href="/projects"><img src={img} alt="Placeholder project visual"><p class="project-meta">{meta}</p><h3 class="type-card-title">{title}</h3></a>)}</div></div></section>
<section class="section" id="process"><div class="container"><span class="eyebrow">How we work</span><h2 class="type-section-title">A clear path from first conversation to handover.</h2><div class="cards">{['Understand','Plan & Visualise','Execute & Deliver'].map((x,i)=><article class="card"><span class="eyebrow">0{i+1}</span><h3 class="type-card-title">{x}</h3><p>Clear communication, documented decisions and founder-led coordination at every stage.</p></article>)}</div></div></section>
</BaseLayout>
