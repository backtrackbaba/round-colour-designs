---
import {getCollection,render} from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import Button from '../../components/Button.astro'; import ProjectCard from '../../components/ProjectCard.astro'; import {site} from '../../config/site'; import {breadcrumbSchema} from '../../config/schema'; export async function getStaticPaths(){return (await getCollection('projects')).map(entry=>({params:{slug:entry.id},props:{entry}}))} const {entry}=Astro.props; const {Content}=await render(entry); const all=await getCollection('projects'); const related=all.filter(x=>x.id!==entry.id).slice(0,2); const crumbs=[{label:'Home',href:'/'},{label:'Projects',href:'/projects/'},{label:entry.data.title,href:`/projects/${entry.id}/`}];
---
<BaseLayout title={`${entry.data.title} — ${entry.data.category} Project`} description={entry.data.summary} ogImage={entry.data.cover.src} type="article" jsonLd={[breadcrumbSchema(crumbs),{'@context':'https://schema.org','@type':'CreativeWork',name:entry.data.title,description:entry.data.summary,image:new URL(entry.data.cover.src,site.url).toString(),creator:{'@type':'Organization',name:site.name},spatialCoverage:entry.data.location}]}><section class="project-hero"><div class="container"><Breadcrumbs items={crumbs}/><p class="eyebrow">{entry.data.category} · {entry.data.location}</p><h1 class="type-page-title">{entry.data.title}</h1><p class="type-body-lg">{entry.data.summary}</p><dl class="project-facts"><div><dt>Location</dt><dd>{entry.data.location}</dd></div><div><dt>Area</dt><dd>{entry.data.area}</dd></div><div><dt>Year</dt><dd>{entry.data.year}</dd></div></dl></div><div class="container"><div class="media-wrap project-cover"><img src={entry.data.cover.src} alt={`${entry.data.title} placeholder project visual`}/>{entry.data.placeholder&&<span class="image-note">Temporary project image and details</span>}</div></div></section><section class="section"><div class="container project-content"><article class="prose"><Content/></article><aside><p class="eyebrow">Scope</p><ul class="check-list">{entry.data.services.map((x:string)=><li>{x}</li>)}</ul><Button href={site.whatsapp} variant="whatsapp" icon="whatsapp" external>Discuss a similar project</Button></aside></div></section><section class="section theme-warm"><div class="container"><h2 class="type-section-title">Explore more projects</h2><div class="project-grid related">{related.map(x=><ProjectCard slug={x.id} {...x.data} image={x.data.cover.src}/>)}</div></div></section></BaseLayout>
