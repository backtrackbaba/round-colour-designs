---
import {site} from '../config/site'; import Button from './Button.astro';
---
<header class="header"><div class="container nav"><a href="/" aria-label="Round Colour Designs home"><img class="brand-logo" src="/assets/logo-header-transparent.png" alt="Round Colour Designs"></a><nav class="nav-links" aria-label="Primary"><a href="/about/">Studio</a><a href="/services/">Services</a><a href="/projects/">Projects</a><a href="/#process">Process</a><a href="/contact/">Contact</a><Button href={site.whatsapp} variant="primary" icon="whatsapp" external>WhatsApp Us</Button></nav><button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu"><span class="sr-only">Open navigation</span><span></span><span></span><span></span></button></div><div id="mobile-menu" class="mobile-menu" hidden><nav class="container" aria-label="Mobile"><a href="/about/">Studio</a><a href="/services/">Services</a><a href="/projects/">Projects</a><a href="/#process">Process</a><a href="/contact/">Contact</a><Button href={site.whatsapp} variant="whatsapp" icon="whatsapp" external>Chat on WhatsApp</Button></nav></div></header><script>const b=document.querySelector('.menu-btn');const m=document.querySelector('#mobile-menu');if(b&&m){b.addEventListener('click',()=>{const open=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!open));m.hidden=open;if(!open)m.querySelector('a')?.focus();});m.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{m.hidden=true;b.setAttribute('aria-expanded','false')}));}</script>
