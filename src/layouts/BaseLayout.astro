---
import '../styles/global.css'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import FontSwitcher from '../components/FontSwitcher.astro'; import WhatsAppIcon from '../components/WhatsAppIcon.astro'; import SEO from '../components/SEO.astro'; import {site} from '../config/site';
const {title='Interior Designers in Mulund, Mumbai',description='Round Colour Designs is a founder-led interior design studio in Mulund, Mumbai.',canonical,ogImage,type='website',jsonLd=[]}=Astro.props;
---
<!doctype html><html lang="en-IN" data-font-theme="editorial"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><SEO title={title} description={description} canonical={canonical} ogImage={ogImage} type={type} jsonLd={jsonLd}/><link rel="icon" href="/assets/logo-full.png"><slot name="head"/></head><body><a class="skip-link" href="#content">Skip to content</a><Header/><main id="content"><slot/></main><Footer/><FontSwitcher/><a class="whatsapp" href={site.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="Chat with Round Colour Designs on WhatsApp"><WhatsAppIcon/><span>WhatsApp</span></a></body></html>
